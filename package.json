{
  "name": "midibrowser",
  "version": "1.0.0",
  "description": "OSX Finder-style MIDI file browser with Quick Look playback",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run watch\" \"npm run electron-dev\"",
    "watch": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "electron-dev": "wait-on dist/main.js && electron ."
  },
  "keywords": [
    "midi",
    "browser",
    "electron",
    "music"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.3.3",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "soundfont-player": "^0.12.0",
    "tone": "^14.7.77"
  }
}
